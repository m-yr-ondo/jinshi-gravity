# Jinshi Gravity - local development environment.
# Copy this file to .env (apps/server/.env and apps/client/.env) and adjust.
# Never commit the real .env file.

# ---- Server (apps/server) ----
# Port the Colyseus server listens on. Keep distinct from jinshi-checkers (2567).
GRAVITY_SERVER_PORT=2568
# Public URL the client uses to reach the server over WebSocket.
# For local dev, point at the server port below.
GRAVITY_SERVER_PUBLIC_URL=ws://localhost:2568
# Reconnection grace period in milliseconds before a disconnected seat is eliminated.
GRAVITY_RECONNECT_GRACE_MS=15000
# State broadcast rate per second (server -> client snapshots).
GRAVITY_BROADCAST_RATE=20
# Matchmaking: minimum ready players required for multiplayer start.
GRAVITY_MIN_PLAYERS=2
# Maximum concurrent players in one room.
GRAVITY_MAX_PLAYERS=8

# ---- Client (apps/client) ----
# WebSocket endpoint the Vite client connects to.
VITE_GRAVITY_SERVER_URL=ws://localhost:2568
# Whether the game starts muted.
VITE_AUDIO_MUTED=false
