  },
  "devDependencies": {
    "@colyseus/core": "^0.17.10",
    "@colyseus/sdk": "^0.17.26",
    "@colyseus/testing": "^0.17.11",
    "@types/express": "^4.17.23",
    "@types/node": "^22.16.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
