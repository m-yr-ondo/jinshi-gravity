{
  "name": "@jinshi-gravity/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite + Phaser 3 client for Jinshi Gravity.",
  "scripts": {
    "dev": "vite --port 5175",
