{
  "name": "@jinshi-gravity/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript authoritative simulation, maps, protocol and types for Jinshi Gravity.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./maps": {
      "types": "./dist/maps/index.d.ts",
      "import": "./dist/maps/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
